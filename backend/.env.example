# AI Path Finder — Backend Configuration
# Copy this file to .env and configure your values

# Database (SQLite is default, works without PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./ai_pathfinder.db

# AI Provider — Set to "gemini" for real AI, "deterministic" for offline mode
AI_PROVIDER=gemini

# Gemini API Key (optional — app works fully without it using deterministic fallback)
# Get a free key at: https://aistudio.google.com/
AI_API_KEY=

# App Settings
APP_NAME=AI Path Finder
DEBUG=false
SEED_DEMO_DATA=true

# CORS (comma-separated list of frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
